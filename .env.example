# ============================================================
#  Настройки бота. Скопируйте этот файл в .env и заполните.
#  Значения после знака "=" — без кавычек.
# ============================================================

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Секретная ссылка на календарь в формате iCal (обязательно)
# Google Calendar → Настройки календаря → «Секретный адрес в формате iCal»
ICAL_URL=

# Слова, по которым бот понимает, что событие — это занятие.
# Через запятую, можно несколько: урок,занятие,репетитор,Математика
LESSON_KEYWORDS=урок,занятие

# Часовой пояс (для России можно оставить как есть)
TZ=Asia/Novosibirsk

# Сколько недель тянуть из календаря
HISTORY_WEEKS=8
FUTURE_WEEKS=8

# Как часто перечитывать календарь (минуты)
SYNC_INTERVAL_MIN=15

# Итоги недели: день (1=Пн ... 7=Вс) и время
SUMMARY_ENABLED=true
SUMMARY_WEEKDAY=7
SUMMARY_TIME=20:00

# Валюта в подсчётах
CURRENCY=₽

# Ваш Telegram ID — если указать, бот будет отвечать только вам.
# Узнать можно, отправив боту сообщение: он покажет ID в ответе.
# 0 или пусто — бот открыт для всех, кто знает его адрес.
OWNER_CHAT_ID=

# Первый день недели: 1=понедельник ... 7=воскресенье
WEEK_START=1

# Учитывать события «на весь день»
INCLUDE_ALL_DAY=false

# Занятия раньше этого часа НЕ учитываются («ещё не назначенные», переносите их)
MIN_LESSON_HOUR=7

# Удалять старые сообщения бота (чтобы чат не зарастал)
CLEANUP_MESSAGES=true

# ==== Облачная база данных (Supabase) — данные переживают перезапуски ====
# Адрес проекта, например https://xxxx.supabase.co
SUPABASE_URL=
# Секретный ключ (Secret key) из Supabase → Project Settings → API
SUPABASE_KEY=

# Уровень логов: DEBUG, INFO, WARNING
LOG_LEVEL=INFO